<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/iv_sheet_medal"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_medal"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/medal_icon_desc" />

    <TextView
        android:id="@+id/tv_sheet_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="22sp"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tv_sheet_ioc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tv_sheet_rank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_sheet_times"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tv_sheet_efficiency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="16dp" />

    <!-- Gold row with progress bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_sheet_gold"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pb_gold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:indeterminate="false"
            app:trackThickness="8dp"
            app:indicatorColor="@color/medal_gold"
            app:trackColor="#E0E0E0"
            app:trackCornerRadius="4dp" />

        <TextView
            android:id="@+id/tv_sheet_gold_pct"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_minor"
            android:gravity="end" />
    </LinearLayout>

    <!-- Silver row with progress bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_sheet_silver"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pb_silver"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:indeterminate="false"
            app:trackThickness="8dp"
            app:indicatorColor="@color/medal_silver"
            app:trackColor="#E0E0E0"
            app:trackCornerRadius="4dp" />

        <TextView
            android:id="@+id/tv_sheet_silver_pct"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_minor"
            android:gravity="end" />
    </LinearLayout>

    <!-- Bronze row with progress bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_sheet_bronze"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pb_bronze"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:indeterminate="false"
            app:trackThickness="8dp"
            app:indicatorColor="@color/medal_bronze"
            app:trackColor="#E0E0E0"
            app:trackCornerRadius="4dp" />

        <TextView
            android:id="@+id/tv_sheet_bronze_pct"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_minor"
            android:gravity="end" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tv_sheet_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp" />

</LinearLayout>
