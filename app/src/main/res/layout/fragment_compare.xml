<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Head to Head"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Country names row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tv_cmp_a_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:maxLines="2" />

            <TextView
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="vs"
                android:textSize="13sp"
                android:textColor="@color/text_minor"
                android:gravity="center"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/tv_cmp_b_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:maxLines="2" />
        </LinearLayout>

        <!-- IOC codes row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_cmp_a_ioc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:gravity="center" />

            <View android:layout_width="48dp" android:layout_height="1dp" />

            <TextView
                android:id="@+id/tv_cmp_b_ioc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:gravity="center" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="12dp" />

        <!-- Gold row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tv_cmp_a_gold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:gravity="end"
                android:paddingEnd="8dp" />

            <TextView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="Gold"
                android:textSize="12sp"
                android:textColor="@color/medal_gold"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tv_cmp_b_gold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:gravity="start"
                android:paddingStart="8dp" />
        </LinearLayout>

        <!-- Silver row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tv_cmp_a_silver"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:gravity="end"
                android:paddingEnd="8dp" />

            <TextView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="Silver"
                android:textSize="12sp"
                android:textColor="@color/medal_silver"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tv_cmp_b_silver"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:gravity="start"
                android:paddingStart="8dp" />
        </LinearLayout>

        <!-- Bronze row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tv_cmp_a_bronze"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:gravity="end"
                android:paddingEnd="8dp" />

            <TextView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="Bronze"
                android:textSize="12sp"
                android:textColor="@color/medal_bronze"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tv_cmp_b_bronze"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:gravity="start"
                android:paddingStart="8dp" />
        </LinearLayout>

        <!-- Total row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_cmp_a_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="18sp"
                android:gravity="end"
                android:paddingEnd="8dp" />

            <TextView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="Total"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tv_cmp_b_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="18sp"
                android:gravity="start"
                android:paddingStart="8dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="12dp" />

        <!-- Efficiency row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tv_cmp_a_eff"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                android:gravity="end"
                android:paddingEnd="8dp" />

            <TextView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="Medals/app"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tv_cmp_b_eff"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                android:gravity="start"
                android:paddingStart="8dp" />
        </LinearLayout>

        <!-- Rank row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_cmp_a_rank"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                android:gravity="end"
                android:paddingEnd="8dp" />

            <TextView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="Rank"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tv_cmp_b_rank"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                android:gravity="start"
                android:paddingStart="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
